# Mindest-iOS-Version. Den Ausschlag geben nicht die Firebase-Pakete, die mit
# 15.0 auskaemen, sondern die drei ML-Kit-Pakete: google_mlkit_commons,
# google_mlkit_face_detection und google_mlkit_pose_detection tragen in ihrer
# .podspec deployment_target 15.5. Liegt das Ziel darunter, bricht CocoaPods
# ab, bevor ueberhaupt uebersetzt wird (DECISIONS 99). Im Xcode-Target steht
# derselbe Wert als IPHONEOS_DEPLOYMENT_TARGET.
#
# Diese Datei liegt bewusst im Repo, obwohl Flutter sie beim ersten
# `flutter build ios` selbst anlegen wuerde: Der Bau laeuft auf einem
# Mietrechner in der CI, und der soll nicht jedes Mal eine frische
# Standardfassung ohne unseren Berechtigungs-Filter erzeugen.
platform :ios, '15.5'

# CocoaPods schickt sonst bei jedem Lauf Nutzungsstatistiken und macht den
# Bau langsamer.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# --- ML Kit auf dem Apple-Silicon-Simulator --------------------------------
#
# Googles GoogleMLKit-Pakete liefern nur Scheiben fuer arm64-iphoneos und
# x86_64-iphonesimulator und schliessen arm64 fuer Simulator-Bauten aus. Auf
# einem Apple-Silicon-Mac - und die Mac-Mietrechner von GitHub sind welche -
# faellt der Simulator-Bau deshalb aus, und zwar mit einer irrefuehrenden
# Meldung: "Framework 'Pods_Runner' not found". Der Zusammenhang ist nicht
# zu erraten; er steht in der README von google_mlkit_commons und im
# Fehlerbericht bei Google (issuetracker 178965151).
#
# Der Helfer stammt vom Paket selbst und ist dort ausdruecklich vorgesehen.
# Er beschriftet die arm64-Scheibe bei jedem Bau passend zum Ziel um -
# Simulator beim Simulator-Bau, Geraet beim Geraetebau. Deshalb bleibt der
# Geraetebau unberuehrt, und es ist kein Umschalten von Hand noetig
# (DECISIONS 104).
# Der Pfad kommt aus .flutter-plugins-dependencies und nicht aus
# ios/.symlinks/, wie es die README zeigt. Grund: .symlinks entsteht erst
# waehrend `pod install` selbst, dieses `require` laeuft aber vorher. Auf
# einem Rechner, auf dem schon einmal gebaut wurde, faellt das nie auf - auf
# einem frischen CI-Rechner scheitert der allererste pod install daran, und
# zwar auch der fuer das Geraet. Genau das ist am 04.09.2026 passiert.
#
# .flutter-plugins-dependencies dagegen schreibt `flutter pub get`, also
# lange vor pod install, und es nennt zu jedem Paket den vollen Pfad.
def mlkit_helfer_pfad
  # __FILE__ statt __dir__, wie es flutter_root weiter oben auch macht:
  # CocoaPods liest das Podfile ueber instance_eval, und dabei ist __FILE__
  # das Verlaessliche. File.expand_path schneidet den Dateinamen ab, deshalb
  # zwei Ebenen hoch statt einer.
  liste = File.expand_path(File.join('..', '..', '.flutter-plugins-dependencies'), __FILE__)
  return nil unless File.exist?(liste)

  require 'json'
  eintraege = JSON.parse(File.read(liste)).dig('plugins', 'ios') || []
  eintrag = eintraege.find { |p| p['name'] == 'google_mlkit_commons' }
  return nil unless eintrag && eintrag['path']

  pfad = File.join(eintrag['path'], 'ios', 'scripts', 'apple_silicon_simulator')
  File.exist?("#{pfad}.rb") ? pfad : nil
rescue StandardError
  # Ein kaputter Helfer darf den Bau nicht aufhalten - er betrifft nur den
  # Simulator. Der Geraetebau ist das Wichtigere von beiden.
  nil
end

MLKIT_HELFER = mlkit_helfer_pfad
require MLKIT_HELFER if MLKIT_HELFER

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # --- Berechtigungs-Liste fuer permission_handler ---------------------
      #
      # ACHTUNG, haeufiges Missverstaendnis: In permission_handler_apple
      # 9.6.1 - der Fassung hinter dem gepinnten permission_handler 12.0.0 -
      # steht in PermissionHandlerEnums.h fuer JEDE Berechtigung
      # `#ifndef ... #define ... 0`. Voreingestellt ist also nichts an. Diese
      # Liste nimmt nichts weg; die drei Einsen schalten etwas zu. Bei
      # aelteren Fassungen war es umgekehrt (DECISIONS 96).
      #
      # Sie steht trotzdem hier, weil sie ausdruecklich sagt, was gewollt
      # ist, statt sich auf eine Voreinstellung zu verlassen, die das Paket
      # zwischen zwei Fassungen schon einmal umgedreht hat.
      #
      # Die App fragt heute keine dieser Berechtigungen ueber
      # permission_handler ab - es wird ausschliesslich fuer
      # `openAppSettings` benutzt (camera_screen.dart:1361). Kamera, Fotos
      # und Benachrichtigungen stehen trotzdem auf 1: Ihre Erklaertexte sind
      # gepflegt, und eine spaeter ergaenzte Abfrage wirkt damit sofort,
      # statt still "dauerhaft verweigert" zu liefern. Die APIs dahinter
      # stecken ueber camera und image_picker ohnehin im Programm.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',

        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_LOCATION_ALWAYS=0',
        'PERMISSION_LOCATION_WHENINUSE=0',
        'PERMISSION_PHOTOS_ADD_ONLY=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end

  # Muss ans Ende: Der Helfer liest die Einstellungen, die oben gesetzt
  # wurden, und entfernt unter anderem die Zeile, die arm64 fuer den
  # Simulator ausschliesst.
  if MLKIT_HELFER
    mlkit_apple_silicon_simulator_patch(installer)
  else
    Pod::UI.warn 'ML-Kit-Helfer nicht gefunden: Bauten fuer den ' \
                 'Apple-Silicon-Simulator werden fehlschlagen. Der ' \
                 'Geraetebau ist davon nicht betroffen (DECISIONS 104).'
  end
end
