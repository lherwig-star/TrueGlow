<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Die In-App-Kamera mit Live-Vorschau braucht den Zugriff. Ohne
         Berechtigung bleibt der Import aus der Galerie als Weg offen,
         deshalb ist das Feature weiterhin nicht zwingend. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- camera_android_camerax fordert diese Funktion ohne required-Angabe an,
         was "erforderlich" bedeutet. Play wuerde die App damit auf Geraeten mit
         Kamera beschraenken – die App laesst sich aber komplett ueber die
         Galerie bedienen. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />

    <!-- Erinnerung an einen faelligen Check-in. Ohne Berechtigung faellt nur
         die Push weg – faellige Check-ins zeigt die App beim Start selbst. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Geplante Erinnerungen ueberleben einen Neustart des Geraets. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Aus dem Merged Manifest entfernt. Beide kommen von
         camera_android_camerax und werden von dieser App nicht gebraucht:
         Es wird nie Video oder Ton aufgenommen, und Fotos landen
         ausschliesslich im app-eigenen Verzeichnis.
         Vollstaendige Herleitung in DECISIONS.md, Abschnitt 23. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- Vorsichtsmassnahme, kein aktueller Fund: Keine Bibliothek im Baum
         deklariert READ_EXTERNAL_STORAGE (im Gegensatz zu WRITE oben steht
         hier im Merger-Report keine REJECTED-Quelle). Historisch gewaehrt
         Android READ automatisch mit, wenn WRITE_EXTERNAL_STORAGE gehalten
         wird – das greift ohnehin nicht mehr, seit WRITE oben entfernt ist.
         Der Eintrag bleibt aus Symmetrie zu WRITE stehen, falls eine
         kuenftige Abhaengigkeit sie doch einschleppt. Der Galerie-Import
         laeuft ueber den System-Picker und bekommt seine Leseerlaubnis pro
         Datei mitgeliefert – eine Speicherberechtigung braucht er nicht. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Werbe-ID. Firebase Analytics bringt sie ueber
         play-services-measurement mit; wir wollen sie ausdruecklich nicht.
         Play fragt im Data-Safety-Formular danach, und "keine Werbe-ID" darf
         nicht daran scheitern, dass eine Abhaengigkeit sie mitschleppt.
         Die beiden AdServices-Berechtigungen gehoeren zur selben
         Attributionsmechanik. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:label="TrueGlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        tools:replace="android:label"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/datenausnahmen">
        <!-- allowBackup=false ist eine bewusste Entscheidung aus der Roadmap:
             Ohne sie wandern Hive-Dateien UND Gesichtsfotos in Googles
             automatisches Cloud-Backup, ohne dass die App das je erwaehnt.
             Was einen Geraetewechsel ueberleben soll, laeuft ueber das Konto
             (Phase 1.6) – die Fotos ausdruecklich nicht. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Ohne diese beiden Empfaenger zeigt Android eine geplante
             Benachrichtigung ueberhaupt nicht an. Das Plugin bringt sie
             ausdruecklich NICHT in seinem eigenen Manifest mit; sein Manifest
             enthaelt nur zwei Berechtigungen. Ein Blick in das
             zusammengefuehrte Manifest unter build/ zeigt es:

               grep -o '<receiver[^>]*' build/app/intermediates/merged_manifest/...

             `ScheduledNotificationReceiver` stellt die Benachrichtigung zur
             geplanten Zeit zu. `ScheduledNotificationBootReceiver` legt die
             Termine nach einem Neustart des Geraets wieder an – ohne ihn
             waeren sie weg, und die App merkt davon nichts, weil sie zu dem
             Zeitpunkt nicht laeuft. `MY_PACKAGE_REPLACED` deckt denselben
             Fall nach einem App-Update ab. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher oeffnet die Rechtstexte im Browser. Ohne diesen
             Eintrag meldet canLaunchUrl ab Android 11 immer false. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
