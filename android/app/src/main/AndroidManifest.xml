<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Die In-App-Kamera mit Live-Vorschau braucht den Zugriff. Ohne
         Berechtigung bleibt der Import aus der Galerie als Weg offen,
         deshalb ist das Feature weiterhin nicht zwingend. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- camera_android_camerax fordert diese Funktion ohne required-Angabe an,
         was "erforderlich" bedeutet. Play wuerde die App damit auf Geraeten mit
         Kamera beschraenken – die App laesst sich aber komplett ueber die
         Galerie bedienen. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required" />

    <!-- Erinnerung an einen faelligen Check-in. Ohne Berechtigung faellt nur
         die Push weg – faellige Check-ins zeigt die App beim Start selbst. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Geplante Erinnerungen ueberleben einen Neustart des Geraets. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Aus dem Merged Manifest entfernt. Beide kommen von
         camera_android_camerax und werden von dieser App nicht gebraucht:
         Es wird nie Video oder Ton aufgenommen, und Fotos landen
         ausschliesslich im app-eigenen Verzeichnis.
         Vollstaendige Herleitung in DECISIONS.md, Abschnitt 23. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:label="TrueGlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        tools:replace="android:label"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/datenausnahmen">
        <!-- allowBackup=false ist eine bewusste Entscheidung aus der Roadmap:
             Ohne sie wandern Hive-Dateien UND Gesichtsfotos in Googles
             automatisches Cloud-Backup, ohne dass die App das je erwaehnt.
             Was einen Geraetewechsel ueberleben soll, laeuft ueber das Konto
             (Phase 1.6) – die Fotos ausdruecklich nicht. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher oeffnet die Rechtstexte im Browser. Ohne diesen
             Eintrag meldet canLaunchUrl ab Android 11 immer false. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
