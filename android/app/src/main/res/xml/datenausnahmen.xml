<?xml version="1.0" encoding="utf-8"?>
<!--
  Ab Android 12 loesen dataExtractionRules android:allowBackup und
  android:fullBackupContent ab. Beide Wege sind hier zugenagelt:

  - cloud-backup: kein automatisches Google-Backup. Sonst landeten Hive-Boxen
    und Gesichtsfotos in Googles Cloud, ohne dass die App das je erwaehnt.
  - device-transfer: auch beim direkten Umzug auf ein neues Geraet bleibt
    nichts zurueck. Was mitkommen soll, laeuft ueber das Konto (Phase 1.6) -
    die Fotos ausdruecklich nicht.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
