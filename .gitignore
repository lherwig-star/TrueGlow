# --- Firebase ---
# Plattform-Konfiguration: enthaelt zwar keine geheimen Schluessel, benennt
# aber das private Projekt. Wird per `flutterfire configure` erzeugt, siehe
# SETUP.md.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Echte Geheimnisse: Service-Account-Schluessel und lokale Function-Configs.
*serviceAccount*.json
*-firebase-adminsdk-*.json
.runtimeconfig.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/.env
functions/.env.*
!functions/.env.example

# --- Cloud Functions (Node) ---
functions/node_modules/
functions/lib/
node_modules/

# --- Diagnose-Stichprobe (SETUP.md 6.5) ---
